---
// The hero: the name and a write-up on the left, an instrument-style panel on the right. Both cycle through the
// apps (and "more to come") on one CSS clock, so the text always describes the scene beside it. No JavaScript;
// hovering pauses the cycle; under reduced motion the first item stays, fully drawn.
import type { App } from "../lib/github";
interface Props { apps: App[] }
const { apps } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const app = (id: string) => apps.find(a => a.id === id);

const STEP = 5; // seconds per item
type Item = { id: string; tab: string; title: string; say: string; more: string; read: string; href: string; c: string };
const plan = app("plan"), plot = app("plot"), atlas = app("atlas");
const items: Item[] = [
  { id: "plan", tab: "Plan", title: plan?.name ?? "Datum Plan", say: plan?.tagline ?? "Plan, schedule, track and report projects.",
    more: plan?.highlights[1] ?? "Critical path to the minute, resources and costs, earned value, reports.", read: "CPM · 6 tasks · critical path 31 d", href: "#app-plan", c: "var(--plan)" },
  { id: "plot", tab: "Plot", title: plot?.name ?? "Datum Plot", say: plot?.tagline ?? "Analyse data and make publication-ready graphs.",
    more: plot?.highlights[0] ?? "Statistics, regression and curve fitting, with results that explain themselves.", read: "4PL fit · EC50 12.4 · R² 0.998", href: "#app-plot", c: "var(--plot)" },
  { id: "atlas", tab: "Atlas", title: atlas?.name ?? "Datum Atlas", say: atlas?.tagline ?? "Choose materials with property charts and selection indices.",
    more: atlas?.highlights[0] ?? "Property charts, selection lines and limits, with a reference for every value.", read: "E½/ρ · slope 2 · 12 pass", href: "#app-atlas", c: "var(--atlas)" },
  { id: "next", tab: "Next", title: "More to come", say: "One family, more tools on the way.",
    more: "Every new app starts from the same engine-first method, design and updater, and from the Datum network.", read: "datum://next · in design", href: `${base}/network`, c: "var(--amber)" },
];
const N = items.length, CYCLE = STEP * N;
const ticks = (n: number, x0: number, x1: number) => Array.from({ length: n + 1 }, (_, i) => x0 + ((x1 - x0) * i) / n);
---
<div class="hp" style={`--cycle:${CYCLE}s;--step:${STEP}s`}>
  <div class="left">
    <h1 id="hero-title" class="title">Datum<span class="sq" aria-hidden="true"></span></h1>
    <p class="lead">Desktop software for engineers, scientists, researchers and analysts. Small, fast and open source; your files stay on your computer.</p>
    <div class="cycle" aria-live="off">
      {items.map((it, i) => (
        <a class="slide" href={it.href} style={`--i:${i};--c:${it.c}`}>
          <span class="mono idx"><b>{String(i + 1).padStart(2, "0")}</b> / {it.title}</span>
          <span class="say">{it.say}</span>
          <span class="more">{it.more}</span>
        </a>
      ))}
    </div>
    <div class="ticks" aria-hidden="true">{items.map((it, i) => <span style={`--i:${i};--c:${it.c}`}><i></i></span>)}</div>
    <div class="btns">
      <a class="btn btn-solid" href="#apps">Get the apps</a>
      <a class="btn btn-line" href={`${base}/network`}>Explore the network</a>
    </div>
  </div>

  <div class="scope" aria-hidden="true">
    <div class="head mono">
      <span class="tabs">{items.map((it, i) => <span style={`--i:${i};--c:${it.c}`}>{it.tab}</span>)}</span>
      <span class="led"></span>
    </div>
    <div class="body">
      <!-- Plan: schedule with a time scale; bars grow in order, then the critical path lights up. -->
      <svg class="scene" style="--i:0;--c:var(--plan)" viewBox="0 0 480 300">
        <g class="axis-t">{ticks(8, 120, 460).slice(0, 8).map((x, i) => <text x={x + 21} y="24">W{i + 1}</text>)}</g>
        <path class="rule" d={ticks(8, 120, 460).map(x => `M${x} 32V286`).join("")} />
        <path class="rule strong" d="M20 32H460" />
        {["Survey", "Design", "Approvals", "Procure", "Build", "Handover"].map((t, i) => <text class="lbl" x="20" y={62 + i * 38}>{t}</text>)}
        <g class="bars">
          {[[120, 82, 0], [182, 104, 1], [266, 62, 1], [244, 84, 0], [308, 110, 1], [418, 0, 1]].map(([x, w, crit], i) => w
            ? <rect class:list={["bar", { crit }]} style={`--k:${i}`} x={x} y={48 + i * 38} width={w} height="18" rx="2" />
            : <path class="ms" style={`--k:${i}`} d={`M${x + 12} ${48 + i * 38}l10 10-10 10-10-10z`} />)}
        </g>
        <path class="crit-path" pathLength="1" d="M202 66V96H182M286 104V134H266M328 134V172H308M418 210V238" />
        <path class="today" d="M300 32V286" /><text class="lbl today-t" x="304" y="282">today</text>
      </svg>

      <!-- Plot: points with error bars, a fitted curve and its band, the fit readout. -->
      <svg class="scene" style="--i:1;--c:var(--plot)" viewBox="0 0 480 300">
        <path class="rule" d={ticks(5, 60, 460).map(x => `M${x} 20V250`).join("") + ticks(4, 20, 250).map(y => `M60 ${y}H460`).join("")} />
        <path class="rule strong" d="M60 20V250H460" />
        <g class="axis-t">{["10⁻²", "10⁻¹", "10⁰", "10¹", "10²", "10³"].map((t, i) => <text x={60 + i * 80} y="270">{t}</text>)}</g>
        <text class="lbl" x="260" y="292" text-anchor="middle">Concentration (nM)</text>
        <path class="band" d="M64 232C150 228 200 210 250 150S330 52 456 40L456 58C330 70 290 130 250 170S150 244 64 244Z" />
        <path class="fit" pathLength="1" d="M64 238C150 236 200 222 250 160S330 58 456 48" />
        <g class="pts">{[[80, 236, 6], [130, 232, 8], [180, 222, 7], [220, 196, 10], [250, 160, 9], [280, 122, 8], [320, 86, 9], [370, 62, 6], [430, 52, 5]].map(([x, y, e], i) =>
          <g style={`--k:${i}`}><path d={`M${x} ${y - e}V${y + e}M${x - 4} ${y - e}h8M${x - 4} ${y + e}h8`} /><circle cx={x} cy={y} r="4.5" /></g>)}</g>
        <g class="readout"><rect x="78" y="34" width="150" height="44" rx="3" /><text x="90" y="52">EC50 = 12.4 nM</text><text x="90" y="69">R² = 0.998</text></g>
      </svg>

      <!-- Atlas: log–log property chart, family envelopes, a selection line of slope 2 sweeping across. -->
      <svg class="scene" style="--i:2;--c:var(--atlas)" viewBox="0 0 480 300">
        <path class="rule" d={ticks(4, 60, 460).map(x => `M${x} 20V250`).join("") + ticks(4, 20, 250).map(y => `M60 ${y}H460`).join("")} />
        <path class="rule strong" d="M60 20V250H460" />
        <g class="axis-t">{["10", "100", "1k", "10k", "100k"].map((t, i) => <text x={60 + i * 100} y="270">{t}</text>)}</g>
        <text class="lbl" x="260" y="292" text-anchor="middle">Density (kg/m³)</text>
        <g class="fam">
          {[[130, 210, 46, 18, -28, "Foams"], [250, 150, 60, 22, -38, "Polymers"], [330, 92, 54, 20, -30, "Composites"], [390, 64, 52, 18, -18, "Metals"], [350, 46, 40, 14, -12, "Ceramics"]].map(([x, y, rx, ry, a, t], i) =>
            <g style={`--k:${i}`}><ellipse cx={x} cy={y} rx={rx} ry={ry} transform={`rotate(${a} ${x} ${y})`} /><text class="lbl" x={x} y={Number(y) + 4} text-anchor="middle">{t}</text></g>)}
        </g>
        <defs><clipPath id="atlas-plot"><rect x="61" y="20" width="399" height="229" /></clipPath></defs>
        <g clip-path="url(#atlas-plot)"><g class="sweep"><path class="sel" d="M40 300L360 -20" /><text class="lbl sel-t" x="262" y="70" text-anchor="end">E½/ρ</text></g></g>
      </svg>

      <!-- Next: a part being drafted on a blueprint grid. -->
      <svg class="scene" style="--i:3;--c:var(--amber)" viewBox="0 0 480 300">
        <path class="rule" d={ticks(12, 20, 460).map(x => `M${x} 20V280`).join("") + ticks(7, 20, 280).map(y => `M20 ${y}H460`).join("")} />
        <path class="draft" pathLength="1" d="M150 90H330V210H150Z" />
        <path class="draft d2" pathLength="1" d="M240 70V230M130 150H350" />
        <circle class="draft d3" pathLength="1" cx="240" cy="150" r="34" />
        <path class="dim" d="M150 236V250M330 236V250M150 244H330" /><text class="lbl dim-t" x="240" y="262" text-anchor="middle">next app</text>
        <path class="plus" d="M240 136V164M226 150H254" />
      </svg>
    </div>
    <div class="foot mono">{items.map((it, i) => <span style={`--i:${i};--c:${it.c}`}>{it.read}</span>)}</div>
  </div>
</div>

<style>
  .hp { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hp:hover *, .hp:hover *::before, .hp:hover *::after { animation-play-state: paused !important; }

  /* Left */
  .left { display: grid; gap: 22px; justify-items: start; }
  .title { font: 600 clamp(56px, 7.4vw, 96px)/.95 var(--display); letter-spacing: -.035em; display: flex; align-items: flex-end; gap: .08em; }
  .sq { width: .2em; height: .2em; background: var(--amber); margin-bottom: .1em; }
  .lead { max-width: 46ch; }
  .cycle { display: grid; width: 100%; min-height: 168px; border-left: 2px solid var(--line-2); }
  .slide { grid-area: 1 / 1; display: grid; gap: 8px; align-content: start; padding: 4px 0 4px 18px; border-left: 2px solid var(--c); margin-left: -2px;
    opacity: 0; visibility: hidden; animation: show var(--cycle) infinite; animation-delay: calc(var(--i) * var(--step)); }
  .slide:first-child { opacity: 1; visibility: visible; }
  .idx { color: var(--muted); font-size: 11.5px; }
  .idx b { color: var(--c); font-weight: 600; }
  .say { font: 600 clamp(20px, 2vw, 26px)/1.25 var(--display); letter-spacing: -.015em; color: var(--ink); }
  .more { color: var(--muted); font-size: 15px; max-width: 52ch; }
  .slide:hover .say { color: var(--c); }
  @keyframes show {
    0% { opacity: 0; visibility: visible; transform: translateY(6px); }
    3%, 22% { opacity: 1; visibility: visible; transform: none; }
    25%, 100% { opacity: 0; visibility: hidden; transform: translateY(-4px); }
  }
  .ticks { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; width: min(100%, 320px); }
  .ticks span { height: 3px; background: var(--line); overflow: hidden; }
  .ticks i { display: block; height: 100%; background: var(--c); transform-origin: left; transform: scaleX(0);
    animation: fill var(--cycle) linear infinite; animation-delay: calc(var(--i) * var(--step)); }
  @keyframes fill { 0% { transform: scaleX(0); } 25% { transform: scaleX(1); } 25.01%, 100% { transform: scaleX(0); } }

  /* Right: the instrument panel */
  .scope { border: 1px solid var(--line-2); background: var(--card); box-shadow: 0 30px 60px -40px rgb(12 26 43 / .45); }
  .head, .foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 14px; height: 40px; font-size: 11px; color: var(--muted); }
  .head { border-bottom: 1px solid var(--line); }
  .foot { border-top: 1px solid var(--line); display: grid; }
  .tabs { display: flex; gap: 2px; }
  .tabs span { padding: 4px 10px; border: 1px solid transparent; animation: tab var(--cycle) infinite; animation-delay: calc(var(--i) * var(--step)); }
  .tabs span:first-child { color: var(--ink); border-color: var(--line-2); }
  @keyframes tab { 0%, 24.9% { color: var(--ink); border-color: var(--c); background: var(--paper); } 25%, 100% { color: var(--muted); border-color: transparent; background: none; } }
  .led { width: 8px; height: 8px; border-radius: 50%; background: #1F7A4D; animation: led 2s ease-in-out infinite; }
  @keyframes led { 50% { opacity: .35; } }
  .foot span { grid-area: 1 / 1; opacity: 0; color: var(--ink); text-transform: none; letter-spacing: .04em; animation: show var(--cycle) infinite; animation-delay: calc(var(--i) * var(--step)); }
  .foot span:first-child { opacity: 1; }
  .body { display: grid; background-color: var(--paper);
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 20px 20px; background-position: -1px -1px; }
  .scene { grid-area: 1 / 1; width: 100%; height: auto; opacity: 0; animation: show var(--cycle) infinite; animation-delay: calc(var(--i) * var(--step)); }
  .scene:first-child { opacity: 1; }
  /* every timed part inside a scene starts with its scene */
  .scene * { --t: calc(var(--i) * var(--step)); }

  .scene text { font: 500 11px var(--mono); fill: var(--muted); }
  .axis-t text { text-anchor: middle; }
  .rule { fill: none; stroke: var(--line-2); stroke-width: 1; stroke-dasharray: 2 4; }
  .rule.strong { stroke: var(--ink); stroke-dasharray: none; stroke-width: 1.4; }

  /* Plan */
  .bar { fill: color-mix(in srgb, var(--c) 45%, var(--card)); transform-box: fill-box; transform-origin: left; transform: scaleX(1);
    animation: grow var(--cycle) infinite; animation-delay: calc(var(--t) + var(--k) * .28s); }
  .bar.crit { animation-name: grow, crit; }
  @keyframes grow { 0% { transform: scaleX(0); } 5%, 100% { transform: scaleX(1); } }
  @keyframes crit { 0%, 11% { fill: color-mix(in srgb, var(--c) 45%, var(--card)); } 14%, 100% { fill: var(--c); } }
  .ms { fill: var(--amber); transform-box: fill-box; transform-origin: center; animation: pop var(--cycle) infinite; animation-delay: calc(var(--t) + 1.6s); }
  @keyframes pop { 0% { transform: scale(0); } 3%, 100% { transform: scale(1); } }
  .crit-path { fill: none; stroke: #C0392B; stroke-width: 1.6; stroke-dasharray: 1; stroke-dashoffset: 0; animation: draw var(--cycle) infinite; animation-delay: calc(var(--t) + 2s); }
  @keyframes draw { 0% { stroke-dashoffset: 1; } 8%, 100% { stroke-dashoffset: 0; } }
  .today { stroke: #C0392B; stroke-width: 1.2; stroke-dasharray: 4 3; }
  .today-t { fill: #C0392B !important; }
  .lbl { fill: var(--ink-2) !important; }

  /* Plot */
  .band { fill: color-mix(in srgb, var(--c) 14%, transparent); opacity: 1; animation: fade var(--cycle) infinite; animation-delay: calc(var(--t) + 2.2s); }
  @keyframes fade { 0% { opacity: 0; } 4%, 100% { opacity: 1; } }
  .fit { fill: none; stroke: var(--c); stroke-width: 2.6; stroke-linecap: round; stroke-dasharray: 1; animation: draw var(--cycle) infinite; animation-delay: calc(var(--t) + .9s); }
  .pts g { animation: fade var(--cycle) infinite; animation-delay: calc(var(--t) + var(--k) * .09s); }
  .pts path { stroke: var(--ink); stroke-width: 1.2; fill: none; }
  .pts circle { fill: var(--card); stroke: var(--ink); stroke-width: 1.6; }
  .readout { animation: fade var(--cycle) infinite; animation-delay: calc(var(--t) + 2.6s); }
  .readout rect { fill: var(--card); stroke: var(--line-2); }
  .readout text { fill: var(--ink); font-weight: 600; }

  /* Atlas */
  .fam g { animation: fade var(--cycle) infinite; animation-delay: calc(var(--t) + var(--k) * .25s); }
  .fam ellipse { fill: color-mix(in srgb, var(--c) 16%, transparent); stroke: var(--c); stroke-width: 1.4; }
  .fam .lbl { font-size: 10px; }
  .sweep { animation: sweep var(--cycle) var(--ease) infinite; animation-delay: calc(var(--t) + 1.3s); }
  @keyframes sweep { 0% { transform: translateX(-140px); } 9%, 100% { transform: translateX(0); } }
  .sel { stroke: var(--amber); stroke-width: 2.4; stroke-dasharray: 8 6; }
  .sel-t { fill: var(--ink) !important; font-weight: 600; }

  /* Next */
  .draft { fill: none; stroke: var(--ink); stroke-width: 1.8; stroke-dasharray: 1; animation: draw var(--cycle) infinite; animation-delay: var(--t); }
  .draft.d2 { stroke-width: 1; stroke-dasharray: .02 .015; opacity: .6; animation: none; }
  .draft.d3 { animation-delay: calc(var(--t) + 1.2s); stroke: var(--amber); stroke-width: 2.4; }
  .dim { stroke: var(--muted); stroke-width: 1; fill: none; }
  .plus { stroke: var(--ink); stroke-width: 2.4; stroke-linecap: round; }

  @media (prefers-reduced-motion: reduce) {
    .slide:not(:first-child), .scene:not(:first-child), .foot span:not(:first-child) { opacity: 0; visibility: hidden; }
    .ticks span:first-child i { transform: scaleX(1); }
  }
  @media (max-width: 960px) {
    .hp { grid-template-columns: 1fr; }
    .cycle { min-height: 190px; }
  }
</style>
