---
import Mark from "./Mark.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const here = Astro.url.pathname.replace(/\/$/, "");
---
<header class="site-head">
  <div class="frame">
    <a class="brand" href={`${base}/`} aria-label="Datum home"><Mark /><span class="word">DATUM</span></a>
    <span class="head-note mono">Free · open source · Windows</span>
    <nav class="head-links mono" aria-label="Main">
      <a href={`${base}/#apps`}>Apps</a>
      <a href={`${base}/network`} aria-current={here === `${base}/network` ? "page" : undefined}>Network</a>
      <a class="wide" href="https://github.com/Edgar-Mendonca/Datum">GitHub</a>
      <button class="theme" type="button" data-theme-toggle aria-label="Theme: Auto, Light or Dark" title="Theme">
        <svg class="i-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
        <svg class="i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></svg>
      </button>
    </nav>
  </div>
</header>
