---
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { familyLogo } from "../lib/github";

interface Props { title: string; description: string; footer?: boolean }
const { title, description, footer = true } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href={familyLogo} type="image/svg+xml" />
  <meta name="theme-color" content="#F2F1EE" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0B1119" media="(prefers-color-scheme: dark)" />
  <!-- Theme: Auto (follows the system), Light or Dark. -->
  <script is:inline>
    (() => {
      const r = document.documentElement, q = matchMedia("(prefers-color-scheme: dark)");
      let mode = "auto"; try { mode = localStorage.getItem("datum-theme") || "auto"; } catch {}
      const set = () => { r.dataset.mode = mode; r.dataset.theme = mode === "auto" ? (q.matches ? "dark" : "light") : mode; dispatchEvent(new Event("datum-theme")); };
      set(); q.addEventListener("change", set);
      addEventListener("click", e => {
        const b = e.target.closest && e.target.closest("[data-theme-toggle]"); if (!b) return;
        mode = { auto: "light", light: "dark", dark: "auto" }[mode];
        try { localStorage.setItem("datum-theme", mode); } catch {}
        set();
      });
    })();
  </script>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  {footer && <Footer />}
</body>
</html>
