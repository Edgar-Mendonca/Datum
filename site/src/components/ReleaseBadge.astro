---
import type { Latest } from "../lib/github";
import { fmtDate } from "../lib/github";
interface Props { latest?: Latest }
const { latest } = Astro.props;
---
{latest
  ? <a class="rb" href={latest.url} title="Release notes"><span class="v">v{latest.version}</span><span class="d">{fmtDate(latest.date)}</span></a>
  : <span class="rb soon"><span class="v">Coming soon</span></span>}

<style>
  .rb { display: inline-flex; border: 1px solid var(--line3); font: 500 11px/1 var(--mono); letter-spacing: .06em; text-decoration: none; color: var(--text2); }
  .rb span { padding: 5px 8px; }
  .v { background: var(--panel2); color: var(--text); font-weight: 600; }
  .d { border-left: 1px solid var(--line3); }
  a.rb:hover { border-color: var(--text2); }
  .soon .v { background: var(--warn-bg); color: var(--warn-fg); text-transform: uppercase; letter-spacing: .1em; }
</style>
