---
import type { App } from "../lib/github";
import { inkOf } from "../lib/github";
import ReleaseBadge from "./ReleaseBadge.astro";
interface Props { app: App }
const { app } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<article class="card app" style={`--a:${app.accent};--ink:${inkOf(app.accent)};--ink2:${inkOf(app.accent)};--on-blue:#fff`}>
  <div class="head">
    <img src={app.logo} width="64" height="64" alt="" />
    <div>
      <h3><a href={`${base}/${app.id}`}>{app.name}</a></h3>
      <ReleaseBadge latest={app.latest} />
    </div>
  </div>
  <p class="tag">{app.tagline}</p>
  <p class="for muted"><span class="cap">For</span> {app.for}</p>
  <div class="btns">
    {app.latest
      ? <a class="btn pri sm" href={`https://github.com/${app.repo}/releases/latest`}>Download</a>
      : <span class="btn sm" aria-disabled="true">Coming soon</span>}
    <a class="btn sm" href={`${base}/${app.id}`} aria-label={`Learn more about ${app.name}`}>Learn more</a>
  </div>
</article>

<style>
  .app { display: flex; flex-direction: column; border-top: 4px solid var(--a); }
  .head { display: flex; gap: 14px; align-items: center; margin-bottom: 14px; }
  .head img { flex: none; }
  h3 { margin: 0 0 6px; font-size: 19px; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--ink); }
  .tag { font-size: 16px; }
  .for { font-size: 14px; flex: 1; }
  .for .cap { margin-right: 6px; }
  .btn.pri:hover { filter: brightness(.85); }
  :global([data-theme="dark"]) h3 a:hover { color: var(--text); text-decoration: underline; }
</style>
