  /* Card stats: stars, forks, downloads, releases */

  /* 04 In use: the figures (icon, number, 7-day change, sparkline), downloads over time, downloads by app, release activity */
  #in-use { --ok-c: #1F7A4D; --star-c: #D99A16; --done-c: #0B7468; }
