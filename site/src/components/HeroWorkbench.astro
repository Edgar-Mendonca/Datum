---
// The hero: "Datum" and "Tools to <phrase>" on the left; on the right the workbench, a 3×3 bench of small
// animated instruments around the datum origin. The active tile plays its animation, the needle at the origin
// turns to it and the blue phrase on the left changes to match. Hover, focus or tap a tile to take over; app
// tiles open their app. Idle, the bench steps through the tiles by itself. Without JavaScript the tiles still
// animate on hover; under reduced motion nothing moves by itself.
import type { App } from "../lib/github";
import Mark from "./Mark.astro";
interface Props { apps: App[] }
const { apps } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const v = (id: string) => { const a = apps.find(x => x.id === id); return a?.latest ? `v${a.latest.version}` : "soon"; };

const sine = (amp: number, len: number, y: number, from = 0, to = 320) => {
  let d = `M${from} ${y}`;
  for (let x = from; x <= to; x += 4) d += `L${x} ${(y + Math.sin((x / len) * Math.PI * 2) * amp).toFixed(1)}`;
  return d;
};

// Tiles in bench order (row by row); the origin sits in the middle. dx/dy: where the tile is from the origin.
type Tile = { id: string; cap: string; sub: string; say: string; href?: string; c: string; dx: number; dy: number; svg: string };
const tiles: Tile[] = [
  { id: "plan", cap: "Plan", sub: v("plan"), say: "plan projects.", href: "#app-plan", c: "var(--plan)", dx: -1, dy: -1, svg: `
    <g class="ink" opacity=".22"><rect x="10" y="15" width="24" height="5"/><rect x="10" y="31" width="18" height="5"/><rect x="10" y="47" width="26" height="5"/><rect x="10" y="63" width="20" height="5"/><rect x="10" y="79" width="16" height="5"/></g>
    <path class="grid" d="M44 8V92M74 8V92M104 8V92M134 8V92" />
    <g class="acc"><rect class="bar" style="--k:0" x="46" y="13" width="40" height="9" rx="2"/><rect class="bar" style="--k:1" x="68" y="29" width="46" height="9" rx="2"/><rect class="bar" style="--k:2" x="92" y="45" width="34" height="9" rx="2"/><rect class="bar" style="--k:3" x="104" y="61" width="36" height="9" rx="2" opacity=".5"/></g>
    <path class="link" d="M86 17.5h4v16M114 33.5h4v16M126 49.5h4v16" />
    <path class="amber ms" d="M146 74l7 7-7 7-7-7z" />
    <path class="today" d="M110 6V94" />` },
  { id: "engineering", cap: "Engineering", sub: "measure", say: "measure and design.", href: "#apps", c: "var(--ink)", dx: 0, dy: -1, svg: `
    <rect class="paper-f ink-s" x="12" y="36" width="138" height="16" rx="2"/>
    <path class="ink-s thin" d="${Array.from({ length: 24 }, (_, i) => `M${22 + i * 5} 36v${i % 5 === 0 ? 8 : 4}`).join("")}"/>
    <path class="ink-f" d="M12 36h14v50l-14-8z"/>
    <g class="jaw"><path class="ink-f" d="M48 30h16v56l-16-8z"/><rect class="amber" x="50" y="56" width="20" height="10" rx="1"/></g>
    <text class="mono-t" x="150" y="24" text-anchor="end">24.80 mm</text>` },
  { id: "plot", cap: "Plot", sub: v("plot"), say: "analyse data.", href: "#app-plot", c: "var(--plot)", dx: 1, dy: -1, svg: `
    <path class="ink-s" d="M18 8V86H152" />
    <path class="grid" d="M18 66H152M18 46H152M18 26H152" />
    <path class="curve acc-s" d="M22 82C52 80 66 76 80 56S104 20 148 16" pathLength="1" />
    <g class="pts acc-f">${[[28, 80], [42, 78], [56, 74], [70, 64], [84, 48], [98, 34], [112, 24], [128, 19], [144, 17]].map(([x, y], i) => `<circle style="--k:${i}" cx="${x}" cy="${y + (i % 2 ? 3 : -3)}" r="3.4"/>`).join("")}</g>` },
  { id: "analysis", cap: "Analysis", sub: "signals", say: "read signals.", href: "#app-plot", c: "var(--em)", dx: -1, dy: 0, svg: `
    <path class="grid" d="M10 50H150M45 8V92M80 8V92M115 8V92" />
    <g class="clip"><g class="wave"><path class="ink-s" d="${sine(22, 70, 50)}" /><path class="acc2" d="${sine(10, 35, 50)}" /></g></g>
    <circle class="amber pulse" cx="80" cy="50" r="4" />` },
  { id: "science", cap: "Science", sub: "experiment", say: "run experiments.", href: "#app-plot", c: "var(--em)", dx: 1, dy: 0, svg: `
    <path class="paper-f ink-s" d="M66 10h28M70 10v26L46 84a6 6 0 0 0 5 8h58a6 6 0 0 0 5-8L90 36V10" />
    <path class="liquid" d="M57 64h46l9 20a5 5 0 0 1-4 7H52a5 5 0 0 1-4-7z" />
    <g class="bub"><circle style="--k:0" cx="72" cy="80" r="3"/><circle style="--k:1" cx="86" cy="84" r="2.4"/><circle style="--k:2" cx="80" cy="78" r="2"/></g>
    <path class="grid" d="M120 30h20M120 44h14M120 58h20" />` },
  { id: "atlas", cap: "Atlas", sub: v("atlas"), say: "choose materials.", href: "#app-atlas", c: "var(--atlas)", dx: -1, dy: 1, svg: `
    <path class="ink-s" d="M18 8V86H152" />
    <path class="grid" d="M18 66H152M18 46H152M18 26H152M52 8V86M86 8V86M120 8V86" />
    <g class="acc-f">
      <ellipse class="bl" style="--k:0" cx="46" cy="66" rx="16" ry="8" transform="rotate(-25 46 66)"/>
      <ellipse class="bl" style="--k:1" cx="82" cy="50" rx="20" ry="9" transform="rotate(-35 82 50)"/>
      <ellipse class="bl" style="--k:2" cx="122" cy="26" rx="18" ry="8" transform="rotate(-30 122 26)"/>
      <ellipse class="bl" style="--k:3" cx="110" cy="66" rx="12" ry="6" transform="rotate(-10 110 66)"/>
    </g>
    <path class="sel" d="M24 92L150 10" />` },
  { id: "research", cap: "Research", sub: "structures", say: "model structures.", href: `${base}/network`, c: "var(--em)", dx: 0, dy: 1, svg: `
    <g transform="translate(80 50)"><g class="mol">
      <path class="ink-s" d="M0 -26L22.5 -13V13L0 26L-22.5 13V-13Z M0 -26V-40M22.5 13L35 20M-22.5 13L-35 20" />
      <circle class="ink-f" cx="0" cy="-26" r="5"/><circle class="ink-f" cx="22.5" cy="13" r="5"/><circle class="ink-f" cx="-22.5" cy="13" r="5"/>
      <circle class="paper-f ink-s" cx="22.5" cy="-13" r="5"/><circle class="paper-f ink-s" cx="0" cy="26" r="5"/><circle class="paper-f ink-s" cx="-22.5" cy="-13" r="5"/>
      <circle class="amber" cx="0" cy="-40" r="5"/><circle class="acc2f" cx="35" cy="20" r="4.5"/><circle class="acc2f" cx="-35" cy="20" r="4.5"/>
    </g></g>` },
  { id: "next", cap: "More to come", sub: "next", say: "build what comes next.", href: "https://github.com/Edgar-Mendonca/Datum/issues/new", c: "var(--amber)", dx: 1, dy: 1, svg: `
    <rect class="dash" x="10" y="10" width="140" height="80" rx="3" />
    <g transform="translate(80 50)"><g class="plus"><path class="ink-s thick" d="M0 -13V13M-13 0H13" /></g></g>` },
];
const angle = (t: Tile) => Math.round((Math.atan2(t.dy, t.dx) * 180) / Math.PI);
const bench = [...tiles.slice(0, 4), null, ...tiles.slice(4)];
---
<div class="hw">
  <div class="left">
    <h1 id="hero-title" class="title">Datum<span class="sq" aria-hidden="true"></span></h1>
    <p class="tools">Tools to <span class="say" data-say>{tiles[0].say}</span></p>
    <p class="lead">Desktop software for engineers, scientists, researchers and analysts. Small, fast and open source; your files stay on your computer.</p>
    <div class="btns">
      <a class="btn btn-solid" href="#apps">Get the apps</a>
      <a class="btn btn-line" href={`${base}/network`}>Explore the network</a>
    </div>
  </div>

  <div class="wb" data-bench style={`--a:${angle(tiles[0])}deg`}>
    {bench.map(t => t
      ? (
        <a class:list={["tile", { on: t === tiles[0] }]} href={t.href} data-tile data-say={t.say} data-cap={t.cap} data-sub={t.sub} data-a={angle(t)} style={`--c:${t.c}`}>
          <svg viewBox="0 0 160 100" aria-hidden="true" set:html={t.svg} />
          <span class="cap mono"><b>{t.cap}</b><span>{t.sub}</span></span>
        </a>
      )
      : (
        <div class="origin" aria-hidden="true">
          <svg viewBox="0 0 160 100">
            <circle class="ring" cx="80" cy="46" r="34" />
            {tiles.map(t => { const a = (angle(t) * Math.PI) / 180; return <path class="tick" d={`M${(80 + Math.cos(a) * 30).toFixed(1)} ${(46 + Math.sin(a) * 30).toFixed(1)}L${(80 + Math.cos(a) * 38).toFixed(1)} ${(46 + Math.sin(a) * 38).toFixed(1)}`} />; })}
            <g class="needle"><path d="M80 46H110" /><circle cx="110" cy="46" r="3" /></g>
            <rect class="datum" x="75" y="41" width="10" height="10" />
          </svg>
          <span class="cap mono"><Mark class="m" /><b data-readout>{tiles[0].cap}</b><span data-readout-sub>{tiles[0].sub}</span></span>
        </div>
      ))}
  </div>
</div>

<script>
  // Drive the bench: one active tile, the needle, the phrase. Hover/focus takes over; idle it cycles.
  const bench = document.querySelector<HTMLElement>("[data-bench]");
  const tiles = [...document.querySelectorAll<HTMLElement>("[data-tile]")];
  const say = document.querySelector<HTMLElement>("[data-say]");
  const readout = document.querySelector<HTMLElement>("[data-readout]"), readoutSub = document.querySelector<HTMLElement>("[data-readout-sub]");
  if (bench && tiles.length && say) {
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let i = 0, held = false, timer = 0;
    const show = (n: number) => {
      i = (n + tiles.length) % tiles.length;
      const t = tiles[i];
      tiles.forEach(x => x.classList.toggle("on", x === t));
      bench.style.setProperty("--a", `${t.dataset.a}deg`);
      if (say.textContent !== t.dataset.say) { say.textContent = t.dataset.say!; say.classList.remove("in"); void say.offsetWidth; say.classList.add("in"); }
      say.style.setProperty("--c", t.style.getPropertyValue("--c"));
      if (readout) readout.textContent = t.dataset.cap!;
      if (readoutSub) readoutSub.textContent = t.dataset.sub!;
    };
    const tick = () => { if (!held && !document.hidden) show(i + 1); };
    if (!still) timer = window.setInterval(tick, 3200);
    tiles.forEach((t, n) => {
      t.addEventListener("pointerenter", () => { held = true; show(n); });
      t.addEventListener("focus", () => { held = true; show(n); });
    });
    bench.addEventListener("pointerleave", () => { held = false; });
    bench.addEventListener("focusout", e => { if (!bench.contains(e.relatedTarget as Node)) held = false; });
    // The inspection light follows the pointer across the bench.
    bench.addEventListener("pointermove", e => { const r = bench.getBoundingClientRect(); bench.style.setProperty("--mx", `${e.clientX - r.left}px`); bench.style.setProperty("--my", `${e.clientY - r.top}px`); });
    void timer;
  }
</script>

<style>
  .hw { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }

  /* Left */
  .left { display: grid; gap: 20px; justify-items: start; }
  .title { font: 600 clamp(56px, 7.4vw, 96px)/.95 var(--display); letter-spacing: -.035em; display: flex; align-items: flex-end; gap: .08em; }
  .sq { width: .2em; height: .2em; background: var(--amber); margin-bottom: .1em; }
  .tools { font: 600 clamp(24px, 2.8vw, 36px)/1.2 var(--display); letter-spacing: -.02em; min-height: 1.25em; }
  .say { --c: var(--em); color: var(--em); display: inline-block; border-bottom: 2px solid color-mix(in srgb, var(--em) 35%, transparent); }
  .say.in { animation: swap .45s var(--ease); }
  @keyframes swap { from { opacity: 0; transform: translateY(.35em); } }
  .lead { max-width: 46ch; }

  /* Right: the bench */
  .wb { --mx: 50%; --my: 50%; position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; padding: 10px;
    border: 1px solid var(--line-2); background-color: var(--bg-2);
    background-image: radial-gradient(260px circle at var(--mx) var(--my), color-mix(in srgb, var(--em) 10%, transparent), transparent 70%); }
  .tile, .origin { display: grid; background: var(--card); border: 1px solid var(--line); position: relative; }
  .tile { cursor: pointer; transition: border-color .25s, box-shadow .25s, transform .25s var(--ease); }
  .tile svg, .origin svg { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; background-color: var(--paper);
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 10px 10px; }
  .cap { display: flex; justify-content: space-between; align-items: center; gap: 6px; padding: 6px 8px; border-top: 1px solid var(--line); font-size: 10px; letter-spacing: .1em; color: var(--muted); white-space: nowrap; overflow: hidden; }
  .cap b { color: var(--ink); font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
  .tile.on { border-color: var(--c); box-shadow: 0 14px 30px -22px rgb(12 26 43 / .55), inset 0 3px 0 var(--c); transform: translateY(-2px); }
  .tile.on .cap b { color: var(--c); }
  .tile:focus-visible { outline: 2px solid var(--c); outline-offset: 2px; }

  /* The origin: the datum square, a dial with a tick per tile, and the needle pointing at the active one */
  .origin { border-color: var(--line-2); }
  .origin svg { background-image: none; }
  .ring { fill: none; stroke: var(--line-2); stroke-dasharray: 2 3; }
  .tick { stroke: var(--muted); stroke-width: 2; stroke-linecap: round; }
  .needle { transform-origin: 80px 46px; transform: rotate(var(--a)); transition: transform .6s cubic-bezier(.3, 1.4, .5, 1); }
  .needle path { stroke: var(--ink); stroke-width: 2.4; stroke-linecap: round; }
  .needle circle { fill: var(--ink); }
  .datum { fill: var(--amber); }
  .origin .cap { justify-content: flex-start; }
  .origin .cap :global(.m) { width: 12px; height: 13px; color: var(--ink); flex: none; }
  .origin .cap span { margin-left: auto; }

  /* Tile drawings */
  .tile :global(.ink), .tile :global(.ink-f) { fill: var(--ink); }
  .tile :global(.ink-s) { fill: none; stroke: var(--ink); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .tile :global(.ink-s.thin) { stroke-width: 1.2; }
  .tile :global(.ink-s.thick) { stroke-width: 4; }
  .tile :global(.paper-f) { fill: var(--card); }
  .tile :global(.grid) { fill: none; stroke: var(--line-2); stroke-width: 1; stroke-dasharray: 2 3; }
  .tile :global(.acc) { fill: var(--c); }
  .tile :global(.acc-f) { fill: color-mix(in srgb, var(--c) 65%, transparent); }
  .tile :global(.acc-s) { fill: none; stroke: var(--c); stroke-width: 3; stroke-linecap: round; }
  .tile :global(.acc2) { fill: none; stroke: var(--em); stroke-width: 2; opacity: .7; }
  .tile :global(.acc2f) { fill: var(--em); }
  .tile :global(.amber) { fill: var(--amber); }
  .tile :global(.link) { fill: none; stroke: var(--ink); stroke-width: 1.2; opacity: .6; }
  .tile :global(.today) { stroke: #C0392B; stroke-width: 1.4; stroke-dasharray: 3 3; }
  .tile :global(.mono-t) { font: 600 11px var(--mono); fill: var(--ink); }
  .tile :global(.liquid) { fill: color-mix(in srgb, var(--em) 35%, transparent); }
  .tile :global(.bub circle) { fill: var(--em); opacity: 0; }
  .tile :global(.sel) { stroke: var(--amber); stroke-width: 2.5; stroke-dasharray: 6 5; }
  .tile :global(.dash) { fill: none; stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 6 5; }
  .tile :global(.clip) { clip-path: inset(8px 10px 8px 10px); }

  /* Animations run only on the active (or hovered) tile; at rest every drawing is complete. */
  .tile:is(.on, :hover) :global(.bar) { transform-box: fill-box; transform-origin: left center; animation: grow 1.1s var(--ease) both; animation-delay: calc(var(--k) * .14s); }
  @keyframes grow { from { transform: scaleX(0); } }
  .tile:is(.on, :hover) :global(.ms) { transform-box: fill-box; transform-origin: center; animation: pop .5s .7s var(--ease) both; }
  @keyframes pop { from { transform: scale(0); } }
  .tile:is(.on, :hover) :global(.jaw) { animation: slide 2.6s ease-in-out infinite; }
  @keyframes slide { 50% { transform: translateX(46px); } }
  .tile :global(.curve) { stroke-dasharray: 1; }
  .tile:is(.on, :hover) :global(.curve) { animation: draw 1.4s ease-out both; }
  @keyframes draw { from { stroke-dashoffset: 1; } }
  .tile:is(.on, :hover) :global(.pts circle) { transform-box: fill-box; transform-origin: center; animation: pop .35s var(--ease) both; animation-delay: calc(var(--k) * .08s); }
  .tile:is(.on, :hover) :global(.wave) { animation: scroll 2.4s linear infinite; }
  @keyframes scroll { to { transform: translateX(-140px); } }
  .tile:is(.on, :hover) :global(.pulse) { transform-box: fill-box; transform-origin: center; animation: beat 1.2s ease-in-out infinite; }
  @keyframes beat { 50% { transform: scale(1.6); opacity: .6; } }
  .tile:is(.on, :hover) :global(.mol) { animation: spin 9s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .tile:is(.on, :hover) :global(.bl) { transform-box: fill-box; transform-origin: center; animation: pop .45s var(--ease) both; animation-delay: calc(var(--k) * .12s); }
  .tile:is(.on, :hover) :global(.sel) { animation: march 1.2s linear infinite; }
  @keyframes march { to { stroke-dashoffset: -22; } }
  .tile:is(.on, :hover) :global(.bub circle) { animation: rise 2.2s ease-in infinite; animation-delay: calc(var(--k) * -.7s); }
  @keyframes rise { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: 1; } 100% { transform: translateY(-34px); opacity: 0; } }
  .tile:is(.on, :hover) :global(.dash) { animation: march 1.6s linear infinite; }
  .tile:is(.on, :hover) :global(.plus) { animation: turn 1.2s var(--ease) both; }
  @keyframes turn { from { transform: rotate(-90deg) scale(.6); } }

  @media (max-width: 960px) { .hw { grid-template-columns: 1fr; } .tools { min-height: 0; } }
  @media (max-width: 520px) { .wb { gap: 6px; padding: 6px; } .cap { font-size: 8.5px; padding: 5px 6px; letter-spacing: .06em; } .cap span { display: none; } }
</style>
