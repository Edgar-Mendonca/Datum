---
import Logo from "./Logo.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const here = Astro.url.pathname.replace(/\/$/, "");
---
<header class="site-head">
  <div class="frame">
    <a class="brand" href={`${base}/`} aria-label="Datum home"><Logo /></a>
    <nav class="head-links mono" aria-label="Main">
      <a href={`${base}/#apps`} aria-current={here.startsWith(`${base}/apps`) ? "page" : undefined}>Apps</a>
      <a href={`${base}/network`} aria-current={here === `${base}/network` ? "page" : undefined}>Network</a>
      <a class="wide" href="https://github.com/Edgar-Mendonca/Datum">GitHub</a>
      <div class="theme" role="radiogroup" aria-label="Theme">
        <button type="button" role="radio" data-theme-set="auto" aria-checked="true" aria-label="Auto: follow the system" title="Auto">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg></button>
        <button type="button" role="radio" data-theme-set="light" aria-checked="false" aria-label="Light" title="Light">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
        <button type="button" role="radio" data-theme-set="dark" aria-checked="false" aria-label="Dark" title="Dark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></svg></button>
      </div>
    </nav>
  </div>
</header>
