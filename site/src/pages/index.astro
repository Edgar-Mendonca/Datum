---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Rail from "../components/Rail.astro";
import { loadAll, loadHome, latestPerApp, statusOf, fmtDate, fmtSize, familyLogo } from "../lib/github";

const apps = await loadAll();
const recent = latestPerApp(apps);
const home = await loadHome();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const letters = "ABCDEFGHIJ";
// Section headings come into focus word by word as they scroll in.
const words = (t: string) => t.split(" ");
const rail: [string, string][] = [["top", "Datum"], ["apps", "Apps"], ["method", "Method"], ["releases", "Releases"]];
---
<Base title="Datum: free, open-source desktop tools for technical work" description="Datum is a family of free, open-source desktop tools for engineers, scientists, researchers and analysts.">
  <!-- Hero: "Datum" and "Tools to …" on the left, one animated tile per app on the right. -->
  <section id="top" class="hero ruled" aria-labelledby="hero-title" data-rail>
    <div class="frame pad"><Hero apps={apps} /></div>
  </section>

  <!-- 01 The apps -->
  <section id="apps" class="ruled" aria-labelledby="apps-h" data-rail>
    <div class="frame">
      <div class="bar glass mono"><span><b>01</b> / The apps</span><span class="r">Windows 10 and 11 · updates itself</span></div>
      <div class="pad sec-intro">
        <h2 id="apps-h" class="h2"><span class="words">{words("Tools that work the same way, for every").map(w => <span>{w}</span>)}</span><span class="rot it" aria-hidden="true"><span>project.</span><span>dataset.</span><span>material.</span><span>next idea.</span></span><span class="sr">project.</span></h2>
        <p class="lead">Each app does one kind of technical work well. They share one window, one ribbon, one help system and one updater, so learning one means knowing them all.</p>
      </div>
      <!-- Datum Home: every app from one window; or each app on its own (the cards below). -->
      <div class="home-band reveal">
        <img src={familyLogo} width="48" height="48" alt="" />
        <div class="home-text">
          <h3 class="h3">Datum Home {home && <span class="mono muted">v{home.version}</span>}</h3>
          <p class="muted">One small window to install, update, open and remove every Datum app. It checks for new versions when you open it. Prefer just one app? Download it on its own below.</p>
        </div>
        <div class="btns">
          {home
            ? <a class="btn btn-solid" href={home.download}>Get Datum Home{home.size ? <span class="dim">{fmtSize(home.size)}</span> : null}</a>
            : <span class="btn btn-line" aria-disabled="true">Coming soon</span>}
          <a class="btn btn-line" href="https://github.com/Edgar-Mendonca/Datum/tree/HEAD/home">Source</a>
        </div>
      </div>
      <div class="apps">
        {apps.map((a, i) => (
          <article id={`app-${a.id}`} class:list={["app", "reveal", { flip: i % 2 }]} style={`--c:var(--${a.id}, ${a.accent})`} aria-labelledby={`${a.id}-name`}>
            <div class="app-bar mono"><span><b>{letters[i]}</b> / {a.name}</span><span>{a.latest ? `v${a.latest.version} · ${fmtDate(a.latest.date)}` : "Coming soon"}</span></div>
            <div class="app-body">
              <figure class="app-shot">
                {a.shots[0]
                  ? <img src={`${base}/${a.shots[0].file}`} width="1440" height="900" alt={`${a.name}: the main window`} loading="lazy" decoding="async" />
                  : <img class="app-logo-big" src={a.logo} width="160" height="160" alt="" />}
              </figure>
              <div class="app-text">
                <div class="app-head">
                  <img src={a.logo} width="40" height="40" alt="" />
                  <h3 id={`${a.id}-name`} class="app-name"><a href={`${base}/apps/${a.id}`}>{a.name}</a></h3>
                  <span class:list={["badge", "mono", statusOf(a).toLowerCase().replace(/\s+/g, "-")]}>{statusOf(a)}</span>
                </div>
                <p class="app-tag">{a.tagline}</p>
                <p class="app-for"><span class="mono">For</span> {a.for}</p>
                {a.highlights.length > 0 && <ul class="hl">{a.highlights.slice(0, 3).map((h, k) => <li style={`--k:${k}`}>{h}</li>)}</ul>}
                <div class="btns">
                  {a.latest
                    ? <a class="btn btn-solid" href={a.latest.download}>Download{a.latest.size ? <span class="dim">{fmtSize(a.latest.size)}</span> : null}</a>
                    : <span class="btn btn-line" aria-disabled="true">Coming soon</span>}
                  <a class="btn btn-line" href={`${base}/apps/${a.id}`}>About {a.name.replace(/^Datum /, "")}<span aria-hidden="true">→</span></a>
                </div>
                <p class="mono app-links"><a href={`https://github.com/${a.repo}`}>Source</a><a href={`https://github.com/${a.repo}/blob/HEAD/CHANGELOG.md`}>What's new</a><a href={`https://github.com/${a.repo}/releases`}>All releases</a><a href={`https://github.com/${a.repo}/issues/new`}>Report an issue</a></p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 Built the same way -->
  <section id="method" class="ruled" aria-labelledby="built-h" data-rail>
    <div class="frame">
      <div class="bar glass mono"><span><b>02</b> / Built the same way</span><span class="r">Engine · window · release · memory</span></div>
      <div class="pad sec-intro">
        <h2 id="built-h" class="h2 words">{words("One method for every app.").map(w => <span>{w}</span>)}</h2>
      </div>
      <ol class="steps">
        <li class="reveal"><span class="mono">A · Engine</span><h3 class="h3">Calculation first</h3><p class="muted">Every app has its own engine in a pure Rust crate, with unit tests. The window only shows what the engine computes.</p>
          <svg viewBox="0 0 120 64" aria-hidden="true"><rect pathLength="1" x="8" y="12" width="40" height="40" /><path pathLength="1" d="M48 32h24M72 20h40v24H72z" /><path pathLength="1" d="M18 24h20M18 32h20M18 40h12" /></svg></li>
        <li class="reveal"><span class="mono">B · Window</span><h3 class="h3">One design</h3><p class="muted">The same ribbon, sidebar, help beside every tool, printing and themes in every app. Only the accent colour changes.</p>
          <svg viewBox="0 0 120 64" aria-hidden="true"><rect pathLength="1" x="8" y="8" width="104" height="48" /><path pathLength="1" d="M8 20h104M30 20v36" /><path pathLength="1" d="M14 14h10" /></svg></li>
        <li class="reveal"><span class="mono">C · Release</span><h3 class="h3">Small and often</h3><p class="muted">Small numbered releases, each one checked and installed with one click from inside the app.</p>
          <svg viewBox="0 0 120 64" aria-hidden="true"><path pathLength="1" d="M8 48h104" /><circle pathLength="1" cx="20" cy="48" r="5" /><circle pathLength="1" cx="48" cy="48" r="5" /><circle pathLength="1" cx="76" cy="48" r="5" /><path d="M104 36l8 12-8 12-8-12z" class="amber" /></svg></li>
        <li class="reveal"><span class="mono">D · Memory</span><h3 class="h3">Written down</h3><p class="muted">Every plan, decision and session is recorded in the repositories and drawn as one map: the Datum network.</p>
          <svg viewBox="0 0 120 64" aria-hidden="true"><path pathLength="1" d="M20 32L52 14M20 32l32 18M52 14l40 4M52 50l40-6M92 18v26M52 14v36" /><circle pathLength="1" cx="20" cy="32" r="5" /><circle pathLength="1" cx="52" cy="14" r="4" /><circle pathLength="1" cx="52" cy="50" r="4" /><circle pathLength="1" cx="92" cy="18" r="4" /><circle pathLength="1" cx="92" cy="44" r="4" /></svg></li>
      </ol>
    </div>
  </section>

  <!-- 03 Latest releases: the newest of each app -->
  <section id="releases" class="ruled" aria-labelledby="rel-h" data-rail>
    <div class="frame">
      <div class="bar glass mono"><span><b>03</b> / Latest releases</span><span class="r">The newest of each app</span></div>
      <h2 id="rel-h" class="sr">Latest releases</h2>
      <ol class="rel">
        {recent.map(r => (
          <li class="reveal" style={`--c:var(--${r.app}, ${r.accent})`}>
            <span class="mono rel-app">{r.name}</span>
            <a class="rel-v mono" href={r.url}>v{r.version}</a>
            <time class="mono muted" datetime={r.date}>{fmtDate(r.date)}</time>
            <span class="rel-sum">{r.summary || "See the release notes."}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Rail items={rail} />
</Base>


<style>
  .hero .frame.pad { padding-block: clamp(48px, 7vw, 96px); }

  .sec-intro { display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; align-items: end; padding-block: clamp(40px, 6vw, 80px); }
  @media (max-width: 860px) { .sec-intro { grid-template-columns: 1fr; } }
  /* The changing word in the apps heading */
  .rot { display: inline-grid; vertical-align: bottom; font-size: 1.12em; }
  .rot span { grid-area: 1 / 1; opacity: 0; animation: words 12s infinite; }
  .rot span:nth-child(2) { animation-delay: 3s; } .rot span:nth-child(3) { animation-delay: 6s; } .rot span:nth-child(4) { animation-delay: 9s; }
  @keyframes words { 0% { opacity: 0; transform: translateY(.3em); filter: blur(3px); } 4%, 23% { opacity: 1; transform: none; filter: none; } 27%, 100% { opacity: 0; transform: translateY(-.3em); filter: blur(3px); } }
  @media (prefers-reduced-motion: reduce) { .rot span:first-child { opacity: 1; } }

  /* Datum Home: one band above the app cards */
  .home-band { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 20px; align-items: center; padding: 22px var(--pad); border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--amber) 9%, var(--paper)); }
  .home-band .h3 { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .home-band .mono { font-size: 10.5px; }
  .home-band p { font-size: 15px; max-width: 64ch; margin-top: 4px; }
  @media (max-width: 860px) { .home-band { grid-template-columns: 48px minmax(0, 1fr); } .home-band .btns { grid-column: 1 / -1; } }

  /* Apps: compact cards with a label bar, the screenshot on a tinted grid, the text beside it */
  .app { border-top: 1px solid var(--line); position: relative; }
  .app::before { content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--c); transform-origin: left; transform: scaleX(0); transition: transform .8s var(--ease); }
  .app:hover::before { transform: scaleX(1); }
  @supports (animation-timeline: view()) { .app::before { transition: none; animation: line both linear; animation-timeline: view(); animation-range: entry 20% cover 30%; } @keyframes line { to { transform: scaleX(1); } } }
  .app-bar { display: flex; justify-content: space-between; gap: 12px; padding: 12px var(--pad); color: var(--muted); font-size: 11px; border-bottom: 1px solid var(--line); }
  .app-bar b { color: var(--c); }
  .app-body { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  .app.flip .app-shot { order: 2; border-right: 0; border-left: 1px solid var(--line); }
  .app-shot { display: grid; place-items: center; padding: clamp(18px, 3vw, 36px); border-right: 1px solid var(--line); overflow: hidden;
    background-color: color-mix(in srgb, var(--c) 7%, var(--paper));
    background-image: linear-gradient(color-mix(in srgb, var(--c) 14%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--c) 14%, transparent) 1px, transparent 1px);
    background-size: 24px 24px; }
  .app-shot img { width: 100%; max-height: 320px; object-fit: cover; object-position: top left; border: 1px solid color-mix(in srgb, var(--c) 28%, var(--line));
    box-shadow: 0 20px 40px -30px rgb(12 26 43 / .5); transition: transform .6s var(--ease); }
  .app:hover .app-shot img { transform: scale(1.03); }
  .app-shot .app-logo-big { width: 140px; border: 0; box-shadow: none; }
  .app-text { padding: clamp(22px, 3vw, 36px) var(--pad); display: grid; gap: 12px; align-content: center; justify-items: start; }
  .app-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .app-name a:hover { color: var(--c); }
  .app-name { font: 600 clamp(24px, 2.4vw, 30px)/1.1 var(--display); letter-spacing: -.02em; }
  .badge { font-size: 10px; padding: 3px 8px; border: 1px solid currentColor; letter-spacing: .12em; }
  .badge.stable { color: #1F7A4D; } .badge.beta { color: var(--c); } .badge.alpha { color: #8A5A00; } .badge.coming-soon { color: var(--muted); }
  :root[data-theme="dark"] .badge.stable { color: #4CC38A; } :root[data-theme="dark"] .badge.alpha { color: #F0B450; }
  .app-tag { font-size: 17px; font-weight: 600; max-width: 34ch; }
  .app-for { color: var(--muted); font-size: 14.5px; }
  .app-for .mono { color: var(--ink); margin-right: 8px; font-size: 11px; }
  .hl { display: grid; gap: 6px; font-size: 14.5px; color: var(--ink-2); }
  .hl li { padding-left: 18px; position: relative; }
  .hl li::before { content: ""; position: absolute; left: 2px; top: .6em; width: 6px; height: 6px; background: var(--amber); }
  .app .btn { min-height: 42px; padding: 0 18px; font-size: 11px; }
  .app .btn-solid:hover { background: var(--c); border-color: var(--c); }
  .app-links { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 10.5px; }
  .app-links a { color: var(--muted); border-bottom: 1px solid var(--line-2); }
  .app-links a:hover { color: var(--c); border-color: var(--c); }
  @media (max-width: 900px) {
    .app-body { grid-template-columns: 1fr; }
    .app-shot, .app.flip .app-shot { order: 0; border: 0; border-bottom: 1px solid var(--line); }
  }

  /* Method: A–D cells; each little drawing draws itself on hover */
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .steps li { display: grid; gap: 10px; align-content: start; padding: 28px var(--pad) 32px; border-right: 1px solid var(--line); transition: background-color .3s; }
  .steps li:hover { background: var(--paper); }
  .steps li:last-child { border-right: 0; }
  .steps .mono { color: var(--em); font-size: 11px; }
  .steps p { font-size: 14.5px; }
  .steps svg { width: 104px; margin-top: 6px; }
  .steps svg :is(rect, path, circle) { fill: none; stroke: var(--ink); stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .steps li:hover svg :is(rect, path, circle) { animation: sketch 1s var(--ease) both; }
  @keyframes sketch { from { stroke-dashoffset: 1; } }
  .steps svg .amber { fill: var(--amber); stroke: none; }
  @media (max-width: 1000px) { .steps { grid-template-columns: 1fr 1fr; } .steps li:nth-child(2) { border-right: 0; } .steps li:nth-child(-n+2) { border-bottom: 1px solid var(--line); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } .steps li { border-right: 0; border-bottom: 1px solid var(--line); } }

  /* Releases: one row per app */
  .rel li { display: grid; grid-template-columns: 160px 110px 120px 1fr; gap: 16px; align-items: baseline; padding: 18px var(--pad); border-bottom: 1px solid var(--line); transition: background-color .3s; }
  .rel li:hover { background: var(--paper); }
  .rel li:last-child { border-bottom: 0; }
  .rel-app { color: var(--c); }
  .rel-v { font-size: 16px; font-weight: 600; letter-spacing: 0; }
  .rel-v:hover { color: var(--c); }
  .rel-sum { color: var(--ink-2); font-size: 15px; }
  @media (max-width: 760px) { .rel li { grid-template-columns: auto auto 1fr; } .rel-sum { grid-column: 1 / -1; } }
</style>
