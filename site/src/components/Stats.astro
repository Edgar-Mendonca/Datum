---
// An app's public numbers as small badges: stars, forks, installer downloads, releases (and issues closed on app pages).
// Each badge has its own colour and icon, links to the matching GitHub page, and its icon moves on hover or focus
// (the star turns and sparkles, the fork swings, the arrow drops, the tag swings, the tick draws). CSS only.
import { fmtNum, type Stats } from "../lib/github";
interface Props { stats: Stats; repo: string; issues?: boolean; size?: "sm" | "md" }
const { stats, repo, issues = false, size = "md" } = Astro.props;
const gh = `https://github.com/${repo}`;
const items = [
  { k: "star", n: stats.stars, label: stats.stars === 1 ? "star" : "stars", href: `${gh}/stargazers`, title: "GitHub stars" },
  { k: "fork", n: stats.forks, label: stats.forks === 1 ? "fork" : "forks", href: `${gh}/forks`, title: "Forks on GitHub" },
  { k: "down", n: stats.downloads, label: "downloads", href: `${gh}/releases`, title: "Installer downloads, all releases" },
  { k: "tag", n: stats.releases, label: stats.releases === 1 ? "release" : "releases", href: `${gh}/releases`, title: "Releases published" },
  ...(issues && stats.closedIssues !== undefined
    ? [{ k: "done", n: stats.closedIssues, label: "issues closed", href: `${gh}/issues?q=is%3Aissue+is%3Aclosed`, title: "Issues closed" }]
    : []),
];
---
<ul class:list={["stats", size]} aria-label="On GitHub">
  {items.map(i => (
    <li>
      <a class:list={["b", i.k]} href={i.href} title={i.title}>
        <span class="ic" aria-hidden="true">
          {i.k === "star" && (
            <svg viewBox="0 0 24 24"><path class="fill" d="M12 2.8l2.75 5.6 6.15.9-4.45 4.33 1.05 6.12L12 16.9l-5.5 2.85 1.05-6.12L3.1 9.3l6.15-.9z" /><path class="spark" d="M20 2v4M18 4h4M3 18v3M1.5 19.5h3" /></svg>
          )}
          {i.k === "fork" && (
            <svg viewBox="0 0 24 24"><g class="swing"><circle cx="6" cy="5" r="2.2" /><circle cx="18" cy="5" r="2.2" /><path d="M6 7.2v1.3c0 2.2 1.8 3.5 6 3.5s6-1.3 6-3.5V7.2" /></g><path d="M12 12v4.8" /><circle cx="12" cy="19" r="2.2" /></svg>
          )}
          {i.k === "down" && (
            <svg viewBox="0 0 24 24"><g class="drop"><path d="M12 3v11" /><path d="M7 9.5l5 5 5-5" /></g><path d="M4 16.5V20h16v-3.5" /></svg>
          )}
          {i.k === "tag" && (
            <svg viewBox="0 0 24 24"><g class="swing"><path d="M3 3h8.2L21 12.8 12.8 21 3 11.2z" /><circle cx="7.6" cy="7.6" r="1.6" /></g></svg>
          )}
          {i.k === "done" && (
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path class="tick" pathLength="1" d="M7.5 12.3l3 3 6-6.3" /></svg>
          )}
        </span>
        <b>{fmtNum(i.n)}</b><span class="lab">{i.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .stats { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .b {
    --k: var(--em);
    display: inline-flex; align-items: center; gap: 7px; height: 32px; padding: 0 12px 0 5px;
    font: 500 11px/1 var(--mono); letter-spacing: .06em; color: var(--ink-2); text-decoration: none;
    background: color-mix(in srgb, var(--k) 7%, var(--card));
    border: 1px solid color-mix(in srgb, var(--k) 30%, var(--line));
    transition: transform .25s var(--ease, ease), border-color .25s, box-shadow .25s, background-color .25s;
  }
  .b b { font: 600 13.5px/1 var(--mono); color: var(--ink); letter-spacing: 0; font-variant-numeric: tabular-nums; }
  .b .lab { text-transform: uppercase; color: var(--muted); font-size: 10px; letter-spacing: .1em; }
  .ic { display: grid; place-items: center; width: 22px; height: 22px; background: color-mix(in srgb, var(--k) 16%, var(--card)); color: var(--k); }
  .ic svg { width: 16px; height: 16px; overflow: visible; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .b:hover, .b:focus-visible {
    transform: translateY(-2px); border-color: var(--k);
    background: color-mix(in srgb, var(--k) 12%, var(--card));
    box-shadow: 0 10px 20px -14px color-mix(in srgb, var(--k) 70%, transparent), inset 0 -2px 0 var(--k);
  }
  .b:focus-visible { outline: 2px solid var(--k); outline-offset: 2px; }

  /* Each number in its own colour (amber, the app's accent, green, family blue, teal). */
  .star { --k: #D99A16; }
  .fork { --k: var(--c, var(--em)); }
  .down { --k: #1F7A4D; }
  .tag { --k: var(--em); }
  .done { --k: #0B7468; }
  :global(:root[data-theme="dark"]) .star { --k: #F2B233; }
  :global(:root[data-theme="dark"]) .down { --k: #4CC38A; }
  :global(:root[data-theme="dark"]) .done { --k: #3FC2B2; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .star { --k: #F2B233; }
    :global(:root:not([data-theme="light"])) .down { --k: #4CC38A; }
    :global(:root:not([data-theme="light"])) .done { --k: #3FC2B2; }
  }

  .star .fill { fill: color-mix(in srgb, var(--k) 35%, transparent); transform-origin: 12px 11.5px; }
  .star .spark { opacity: 0; transform-origin: center; }
  .swing, .drop { transform-origin: 12px 4px; }
  .tag .swing { transform-origin: 4px 4px; }
  .tick { stroke-dasharray: 1; stroke-dashoffset: 0; }

  .star:hover .fill, .star:focus-visible .fill { animation: s-turn .7s var(--ease, ease) both; fill: var(--k); }
  .star:hover .spark, .star:focus-visible .spark { animation: s-spark .7s ease both; }
  .fork:hover .swing, .fork:focus-visible .swing { animation: s-swing .6s ease both; }
  .down:hover .drop, .down:focus-visible .drop { animation: s-drop .8s ease both; }
  .tag:hover .swing, .tag:focus-visible .swing { animation: s-swing .6s ease both; }
  .done:hover .tick, .done:focus-visible .tick { animation: s-tick .5s ease both; }
  @keyframes s-turn { 0% { transform: rotate(0) scale(1); } 50% { transform: rotate(144deg) scale(1.25); } 100% { transform: rotate(216deg) scale(1); } }
  @keyframes s-spark { 0% { opacity: 0; transform: scale(.4); } 50% { opacity: 1; transform: scale(1.1); } 100% { opacity: .9; transform: none; } }
  @keyframes s-swing { 0% { transform: rotate(0); } 30% { transform: rotate(-14deg); } 60% { transform: rotate(9deg); } 100% { transform: rotate(0); } }
  @keyframes s-drop { 0% { transform: none; } 35% { transform: translateY(4px); opacity: .2; } 36% { transform: translateY(-6px); opacity: 0; } 100% { transform: none; opacity: 1; } }
  @keyframes s-tick { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }

  /* Smaller on the cards of the landing page. */
  .sm .b { height: 28px; padding-right: 10px; gap: 6px; }
  .sm .b b { font-size: 12.5px; }
  .sm .ic { width: 20px; height: 20px; }
  .sm .ic svg { width: 14px; height: 14px; }
  @media (prefers-reduced-motion: reduce) { .b, .b * { animation: none !important; transition: none !important; } }
</style>
