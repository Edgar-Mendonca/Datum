    .tl-plot svg, .spark svg { animation: wipe both linear; animation-timeline: view(); animation-range: entry 0% cover 40%; }
  }
  @keyframes grow-x { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes wipe { from { clip-path: inset(-10px 100% -10px 0); } to { clip-path: inset(-10px -10px -10px 0); } }
  @media (prefers-reduced-motion: reduce) { .fig::before, .hbars .track span, .tl-plot svg, .spark svg { animation: none !important; } }

