---
import type { Shot } from "../lib/github";
interface Props { shot: Shot; eager?: boolean }
const { shot, eager } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<figure>
  <a href={`${base}/${shot.file}`}><img src={`${base}/${shot.file}`} alt={shot.alt} width="1440" height="900" loading={eager ? "eager" : "lazy"} decoding="async" /></a>
  <figcaption class="cap">{shot.alt.replace(/^[^:]+:\s*/, "")}</figcaption>
</figure>

<style>
  figure { margin: 0; }
  img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; border: 1px solid var(--line); border-radius: var(--r); background: var(--panel); }
  figcaption { margin-top: 8px; }
</style>
