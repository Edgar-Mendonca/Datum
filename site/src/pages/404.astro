---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base title="Not found · Datum" description="This page does not exist.">
  <section class="ruled"><div class="frame pad" style="padding-block:96px;display:grid;gap:20px;justify-items:start">
    <p class="mono muted">404 / off the datum</p>
    <h1 class="h2">This page does not exist.</h1>
    <a class="btn btn-solid" href={`${base}/`}>Back to Datum</a>
  </div></section>
</Base>
