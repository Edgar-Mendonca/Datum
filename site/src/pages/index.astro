  .htot { font-size: 11px; font-weight: 600; text-align: right; font-variant-numeric: tabular-nums; }
  .hx .hcells span { background: none; height: auto; font-size: 10px; color: var(--muted); white-space: nowrap; overflow: visible; }
  .hkey { display: flex; align-items: center; gap: 6px; font-size: 10px; color: var(--muted); }
  .hkey span { width: 12px; height: 12px; margin-left: 6px; --c: var(--ink-2); }
  .hkey .l1 { background: color-mix(in srgb, var(--c) 30%, var(--card)); }
  .hkey .l2 { background: color-mix(in srgb, var(--c) 55%, var(--card)); }
