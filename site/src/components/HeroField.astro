---
// The hero's field of small vector illustrations: one tile per app (linking to it), tiles for the kinds of
// work Datum serves, and "more to come" slots for the apps still to be built. Pure SVG and CSS animation;
// on narrow screens the tiles become a slowly scrolling strip. Everything stops under reduced motion.
import type { App } from "../lib/github";
interface Props { apps: App[] }
const { apps } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const app = (id: string) => apps.find(a => a.id === id);

/** A gear outline: n teeth, outer radius R, root radius r, centred on (0,0). */
const gear = (n: number, R: number, r: number) => {
  const pts: string[] = [];
  for (let i = 0; i < n; i++) {
    const a = (i / n) * Math.PI * 2, w = Math.PI / n;
    for (const [ang, rad] of [[a - w * .55, r], [a - w * .3, R], [a + w * .3, R], [a + w * .55, r]] as [number, number][])
      pts.push(`${(Math.cos(ang) * rad).toFixed(1)} ${(Math.sin(ang) * rad).toFixed(1)}`);
  }
  return `M${pts.join("L")}Z`;
};
const sine = (amp: number, len: number, y: number, from = 0, to = 320) => {
  let d = `M${from} ${y}`;
  for (let x = from; x <= to; x += 4) d += `L${x} ${(y + Math.sin((x / len) * Math.PI * 2) * amp).toFixed(1)}`;
  return d;
};

type Tile = { id: string; cls: string; cap: string; sub: string; href?: string; c?: string; svg: string };
const tiles: Tile[] = [
  { id: "plan", cls: "t-plan", cap: "Plan", sub: app("plan")?.latest ? `v${app("plan")!.latest!.version}` : "Schedule", href: `#app-plan`, c: "var(--plan)", svg: `
    <g class="ink" opacity=".25"><rect x="10" y="15" width="26" height="5"/><rect x="10" y="31" width="20" height="5"/><rect x="10" y="47" width="28" height="5"/><rect x="10" y="63" width="22" height="5"/><rect x="10" y="79" width="18" height="5"/></g>
    <path class="grid" d="M44 8V92M74 8V92M104 8V92M134 8V92" />
    <g class="acc"><rect class="bar b1" x="46" y="13" width="40" height="9" rx="2"/><rect class="bar b2" x="68" y="29" width="46" height="9" rx="2"/><rect class="bar b3" x="92" y="45" width="34" height="9" rx="2"/><rect class="bar b4" x="104" y="61" width="36" height="9" rx="2" opacity=".55"/></g>
    <path class="link" d="M86 17.5h4v16M114 33.5h4v16M126 49.5h4v16" />
    <path class="amber ms" d="M146 74l7 7-7 7-7-7z" />
    <path class="today" d="M110 6V94" />` },
  { id: "engineering", cls: "t-cal", cap: "Engineering", sub: "Measure", svg: `
    <rect class="paper-f ink-s" x="12" y="30" width="138" height="16" rx="2"/>
    <path class="ink-s thin" d="${Array.from({ length: 24 }, (_, i) => `M${22 + i * 5} 30v${i % 5 === 0 ? 8 : 4}`).join("")}"/>
    <path class="ink-f" d="M12 30h14v52l-14-8z"/>
    <g class="jaw"><path class="ink-f" d="M48 24h16v58l-16-8z"/><rect class="amber" x="50" y="50" width="20" height="10" rx="1"/></g>
    <text class="mono-t" x="150" y="20" text-anchor="end">24.80 mm</text>` },
  { id: "plot", cls: "t-plot", cap: "Plot", sub: app("plot")?.latest ? `v${app("plot")!.latest!.version}` : "Analyse", href: `#app-plot`, c: "var(--plot)", svg: `
    <path class="ink-s" d="M18 8V86H152" />
    <path class="grid" d="M18 66H152M18 46H152M18 26H152" />
    <path class="curve acc-s" d="M22 82C52 80 66 76 80 56S104 20 148 16" pathLength="1" />
    <g class="pts acc-f">${[[28, 80], [42, 78], [56, 74], [70, 64], [84, 48], [98, 34], [112, 24], [128, 19], [144, 17]].map(([x, y], i) => `<circle style="--i:${i}" cx="${x}" cy="${y + (i % 2 ? 3 : -3)}" r="3.4"/>`).join("")}</g>` },
  { id: "analysis", cls: "t-sig", cap: "Analysis", sub: "Signals", svg: `
    <path class="grid" d="M10 50H150M45 8V92M80 8V92M115 8V92" />
    <g class="clip"><g class="wave"><path class="ink-s" d="${sine(22, 70, 50)}" /><path class="acc2" d="${sine(10, 35, 50)}" /></g></g>
    <circle class="amber pulse" cx="80" cy="50" r="4" />` },
  { id: "computation", cls: "t-gear", cap: "Computation", sub: "Engines", svg: `
    <g transform="translate(62 52)"><g class="g1"><path class="ink-f" d="${gear(12, 30, 24)}"/><circle class="paper-f" r="9"/></g></g>
    <g transform="translate(110 40)"><g class="g2"><path class="amber" d="${gear(8, 20.5, 15)}"/><circle class="paper-f" r="6"/></g></g>
    <path class="grid" d="M10 90H150" />` },
  { id: "atlas", cls: "t-atlas", cap: "Atlas", sub: app("atlas")?.latest ? `v${app("atlas")!.latest!.version}` : "Select", href: `#app-atlas`, c: "var(--atlas)", svg: `
    <path class="ink-s" d="M18 8V86H152" />
    <path class="grid" d="M18 66H152M18 46H152M18 26H152M52 8V86M86 8V86M120 8V86" />
    <g class="blobs acc-f">
      <ellipse class="bl" style="--i:0" cx="46" cy="66" rx="16" ry="8" transform="rotate(-25 46 66)"/>
      <ellipse class="bl" style="--i:1" cx="82" cy="50" rx="20" ry="9" transform="rotate(-35 82 50)"/>
      <ellipse class="bl" style="--i:2" cx="122" cy="26" rx="18" ry="8" transform="rotate(-30 122 26)"/>
      <ellipse class="bl" style="--i:3" cx="110" cy="66" rx="12" ry="6" transform="rotate(-10 110 66)"/>
    </g>
    <path class="sel" d="M24 92L150 10" />` },
  { id: "science", cls: "t-lab", cap: "Science", sub: "Experiment", svg: `
    <path class="paper-f ink-s" d="M66 10h28M70 10v26L46 84a6 6 0 0 0 5 8h58a6 6 0 0 0 5-8L90 36V10" />
    <path class="liquid" d="M57 64h46l9 20a5 5 0 0 1-4 7H52a5 5 0 0 1-4-7z" />
    <g class="bub"><circle style="--i:0" cx="72" cy="80" r="3"/><circle style="--i:1" cx="86" cy="84" r="2.4"/><circle style="--i:2" cx="80" cy="78" r="2"/></g>
    <path class="grid" d="M120 30h20M120 44h14M120 58h20" />` },
  { id: "research", cls: "t-mol", cap: "Research", sub: "Structures", svg: `
    <g transform="translate(80 50)"><g class="mol">
      <path class="ink-s" d="M0 -26L22.5 -13V13L0 26L-22.5 13V-13Z M0 -26V-42M22.5 13L36 21M-22.5 13L-36 21" />
      <circle class="ink-f" cx="0" cy="-26" r="5"/><circle class="ink-f" cx="22.5" cy="13" r="5"/><circle class="ink-f" cx="-22.5" cy="13" r="5"/>
      <circle class="paper-f ink-s" cx="22.5" cy="-13" r="5"/><circle class="paper-f ink-s" cx="0" cy="26" r="5"/><circle class="paper-f ink-s" cx="-22.5" cy="-13" r="5"/>
      <circle class="amber" cx="0" cy="-42" r="5"/><circle class="acc2f" cx="36" cy="21" r="4.5"/><circle class="acc2f" cx="-36" cy="21" r="4.5"/>
    </g></g>` },
  { id: "next-1", cls: "t-more", cap: "More to come", sub: "Next app", href: "https://github.com/Edgar-Mendonca/Datum/issues/new", svg: `
    <rect class="dash" x="6" y="6" width="148" height="88" rx="4" />
    <g transform="translate(80 50)"><g class="plus"><path class="ink-s thick" d="M0 -14V14M-14 0H14" /></g></g>` },
  { id: "next-2", cls: "t-more", cap: "Your idea", sub: "Suggest", href: "https://github.com/Edgar-Mendonca/Datum/issues/new", svg: `
    <rect class="dash" x="6" y="6" width="148" height="88" rx="4" />
    <g transform="translate(80 50)"><g class="plus"><path class="ink-s thick" d="M0 -14V14M-14 0H14" /></g></g>` },
];
const Tag = (t: Tile) => t.href ? "a" : "div";
---
<div class="field">
  <svg class="orbits" viewBox="-640 -440 1280 880" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <ellipse id="o1" rx="560" ry="340" /><ellipse id="o2" rx="430" ry="260" class="dot" /><ellipse rx="300" ry="180" />
    <path id="p1" d="M-560 0a560 340 0 1 0 1120 0a560 340 0 1 0 -1120 0" fill="none" />
    <path id="p2" d="M430 0a430 260 0 1 0 -860 0a430 260 0 1 0 860 0" fill="none" />
    <circle r="4" class="sat"><animateMotion dur="60s" repeatCount="indefinite"><mpath href="#p1" /></animateMotion></circle>
    <circle r="3" class="sat amber-s"><animateMotion dur="44s" repeatCount="indefinite" begin="-20s"><mpath href="#p2" /></animateMotion></circle>
    <circle r="3" class="sat"><animateMotion dur="44s" repeatCount="indefinite" begin="-6s"><mpath href="#p2" /></animateMotion></circle>
  </svg>
  <ul class="tiles">
    {[...tiles, ...tiles].map((t, i) => {
      const El = Tag(t), dup = i >= tiles.length;
      return (
        <li class:list={["tile", t.cls, `pos-${t.id}`, { dup }]} style={t.c ? `--c:${t.c}` : undefined} aria-hidden={dup ? "true" : undefined}>
          <El class="tile-in" href={t.href} tabindex={dup ? -1 : undefined} aria-label={t.href ? `${t.cap}: ${t.sub}` : undefined}>
            <svg viewBox="0 0 160 100" aria-hidden="true" set:html={t.svg} />
            <span class="cap mono"><b>{t.cap}</b><span>{t.sub}</span></span>
          </El>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .field { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .orbits { position: absolute; inset: 0; width: 100%; height: 100%; }
  .orbits ellipse { fill: none; stroke: var(--line-2); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .orbits .dot { stroke-dasharray: 2 7; }
  .sat { fill: var(--ink); opacity: .55; }
  .amber-s { fill: var(--amber); opacity: 1; }

  .tiles { position: absolute; inset: 0; }
  .tile { position: absolute; width: 172px; pointer-events: auto; animation: bob var(--d, 8s) ease-in-out infinite; animation-delay: var(--dl, 0s); }
  .tile-in { display: block; overflow: hidden; background: var(--card); border: 1px solid var(--line-2); border-top: 3px solid var(--c, var(--ink)); box-shadow: 0 22px 40px -26px rgb(12 26 43 / .5); transition: transform .35s var(--ease), border-color .3s; }
  a.tile-in:hover { transform: translateY(-4px) rotate(-1deg); border-color: var(--c, var(--ink)); }
  .tile svg { display: block; width: 100%; aspect-ratio: 16 / 10; background-color: var(--paper);
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 10px 10px; }
  .cap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 8px; padding: 7px 9px; border-top: 1px solid var(--line); font-size: 10px; letter-spacing: .1em; color: var(--muted); white-space: nowrap; }
  .cap b { color: var(--ink); font-weight: 600; }
  .t-more .tile-in { background: transparent; border: 0; box-shadow: none; }
  .t-more svg { background: none; }
  .t-more .cap { border-top: 0; }
  .t-more b { color: var(--muted); }

  /* Positions around the wordmark; each tile bobs at its own pace. */
  .pos-plan        { left: 3%;  top: 9%;  --d: 9s; }
  .pos-engineering { left: 21%; top: 2.5%; --d: 11s; --dl: -4s; }
  .pos-analysis    { right: 21%; top: 2.5%; --d: 10s; --dl: -2s; }
  .pos-plot        { right: 3%; top: 9%;  --d: 8.5s; --dl: -5s; }
  .pos-computation { left: 1%;  top: 50%; --d: 12s; --dl: -7s; }
  .pos-atlas       { right: 1%; top: 50%; --d: 9.5s; --dl: -3s; }
  .pos-science     { left: 4%;  top: 76%; --d: 10.5s; --dl: -1s; }
  .pos-next-1      { left: 22%; top: 77%; --d: 13s; }
  .pos-next-2      { right: 22%; top: 77%; --d: 12s; --dl: -6s; }
  .pos-research    { right: 4%; top: 76%; --d: 11.5s; --dl: -8s; }
  @keyframes bob { 50% { transform: translateY(-9px); } }
  .dup { display: none; }

  /* Illustration parts */
  .tile :global(.ink) { fill: var(--ink); }
  .tile :global(.ink-f) { fill: var(--ink); }
  .tile :global(.ink-s) { fill: none; stroke: var(--ink); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .tile :global(.ink-s.thin) { stroke-width: 1.2; }
  .tile :global(.ink-s.thick) { stroke-width: 4; }
  .tile :global(.paper-f) { fill: var(--card); }
  .tile :global(.grid) { fill: none; stroke: var(--line-2); stroke-width: 1; stroke-dasharray: 2 3; }
  .tile :global(.acc) { fill: var(--c); }
  .tile :global(.acc-f) { fill: color-mix(in srgb, var(--c) 70%, transparent); }
  .tile :global(.acc-s) { fill: none; stroke: var(--c); stroke-width: 3; stroke-linecap: round; }
  .tile :global(.acc2) { fill: none; stroke: var(--em); stroke-width: 2; opacity: .7; }
  .tile :global(.acc2f) { fill: var(--em); }
  .tile :global(.amber) { fill: var(--amber); }
  .tile :global(.link) { fill: none; stroke: var(--ink); stroke-width: 1.2; opacity: .6; }
  .tile :global(.today) { stroke: #C0392B; stroke-width: 1.4; stroke-dasharray: 3 3; }
  .tile :global(.mono-t) { font: 600 11px var(--mono); fill: var(--ink); }
  .tile :global(.liquid) { fill: color-mix(in srgb, var(--em) 35%, transparent); }
  .tile :global(.bub circle) { fill: var(--em); }
  .tile :global(.sel) { stroke: var(--amber); stroke-width: 2.5; stroke-dasharray: 6 5; }
  .tile :global(.dash) { fill: none; stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 6 5; }

  /* Animations */
  .tile :global(.bar) { transform-box: fill-box; transform-origin: left center; animation: grow 7s var(--ease) infinite; }
  .tile :global(.b2) { animation-delay: .25s; } .tile :global(.b3) { animation-delay: .5s; } .tile :global(.b4) { animation-delay: .75s; }
  @keyframes grow { 0% { transform: scaleX(0); } 18%, 86% { transform: scaleX(1); } 100% { transform: scaleX(0); } }
  .tile :global(.ms) { transform-box: fill-box; transform-origin: center; animation: pop 7s ease infinite 1s; }
  @keyframes pop { 0%, 15% { transform: scale(0); } 25%, 86% { transform: scale(1); } 100% { transform: scale(0); } }
  .tile :global(.jaw) { animation: slide 6s ease-in-out infinite; }
  @keyframes slide { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(46px); } }
  .tile :global(.curve) { stroke-dasharray: 1; animation: draw 6s ease-in-out infinite; }
  @keyframes draw { 0% { stroke-dashoffset: 1; } 45%, 85% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: -1; } }
  .tile :global(.pts circle) { transform-box: fill-box; transform-origin: center; animation: pop 6s ease infinite; animation-delay: calc(var(--i) * .15s); }
  .tile :global(.clip) { clip-path: inset(8px 10px 8px 10px); }
  .tile :global(.wave) { animation: scroll 4s linear infinite; }
  @keyframes scroll { to { transform: translateX(-140px); } }
  .tile :global(.pulse) { transform-box: fill-box; transform-origin: center; animation: beat 1.6s ease-in-out infinite; }
  @keyframes beat { 50% { transform: scale(1.6); opacity: .6; } }
  .tile :global(.g1) { animation: spin 14s linear infinite; }
  .tile :global(.g2) { animation: spin 9.33s linear infinite reverse; }
  .tile :global(.mol) { animation: spin 40s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .tile :global(.bl) { transform-box: fill-box; transform-origin: center; animation: breathe 5s ease-in-out infinite; animation-delay: calc(var(--i) * -1.2s); }
  @keyframes breathe { 50% { opacity: .55; } }
  .tile :global(.sel) { animation: march 1.6s linear infinite; }
  @keyframes march { to { stroke-dashoffset: -22; } }
  .tile :global(.bub circle) { animation: rise 3.2s ease-in infinite; animation-delay: calc(var(--i) * -1.05s); }
  @keyframes rise { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: 1; } 100% { transform: translateY(-34px); opacity: 0; } }
  .tile :global(.dash) { animation: march 2.4s linear infinite; }
  .tile :global(.plus) { animation: turn 5s var(--ease) infinite; }
  @keyframes turn { 0%, 60% { transform: rotate(0) scale(1); } 80% { transform: rotate(90deg) scale(1.15); } 100% { transform: rotate(90deg) scale(1); } }

  /* Narrow screens: the tiles become a strip that scrolls slowly under the text. */
  @media (max-width: 1100px) {
    .field { position: relative; inset: auto; order: 2; width: calc(100% + 2 * var(--pad)); margin: 36px calc(-1 * var(--pad)) 0; overflow: hidden; pointer-events: auto;
      mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
    .orbits { display: none; }
    .tiles { position: relative; display: flex; gap: 14px; width: max-content; padding: 12px 0; animation: strip 60s linear infinite; }
    .tile, .dup { position: relative; inset: auto; width: 160px; animation: none; display: block; }
    @keyframes strip { to { transform: translateX(-50%); } }
  }
</style>
