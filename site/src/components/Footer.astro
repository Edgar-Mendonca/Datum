---
import Mark from "./Mark.astro";
import { loadAll } from "../lib/github";
const apps = await loadAll();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const gh = "https://github.com/Edgar-Mendonca/Datum";
---
<footer class="site-foot ruled">
  <div class="frame">
    <div class="foot-grid">
      <div>
        <a class="brand" href={`${base}/`} aria-label="Datum home"><Mark /><span class="word">DATUM</span></a>
        <p class="muted" style="margin-top:18px;max-width:36ch">Free, open-source desktop tools for engineers, scientists, researchers and analysts. No accounts, no subscriptions, no telemetry.</p>
      </div>
      <div>
        <h2 class="mono">Download</h2>
        <ul>{apps.map(a => <li><a href={`https://github.com/${a.repo}/releases/latest`}>{a.name}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="mono">Project</h2>
        <ul>
          <li><a href={`${base}/network`}>The Datum network</a></li>
          <li><a href={`${gh}/blob/HEAD/FAMILY.md`}>Design guide</a></li>
          <li><a href={`${gh}/blob/HEAD/MEMORY.md`}>Family memory</a></li>
          <li><a href={gh}>Source on GitHub</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mono">Feedback</h2>
        <ul>
          {apps.map(a => <li><a href={`https://github.com/${a.repo}/issues/new`}>{a.name.replace("Datum ", "")}: report an issue</a></li>)}
          <li><a href={`${gh}/issues/new`}>Idea for a new app</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-word display" aria-hidden="true">DATUM</div>
    <div class="foot-base mono"><span>MIT licence · © 2026 Edgar Mendonca</span><span>Built from the app repositories every day</span></div>
  </div>
</footer>
