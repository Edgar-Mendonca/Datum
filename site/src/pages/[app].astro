---
import Base from "../layouts/Base.astro";
import Roadmap from "../components/Roadmap.astro";
import Shot from "../components/Shot.astro";
import ReleaseBadge from "../components/ReleaseBadge.astro";
import { loadAll, fmtDate, fmtSize, type App } from "../lib/github";

export async function getStaticPaths() {
  return (await loadAll()).map(app => ({ params: { app: app.id }, props: { app } }));
}
const { app } = Astro.props as { app: App };
const gh = `https://github.com/${app.repo}`;
const done = app.changelog.slice(0, 5);
const size = fmtSize(app.latest?.size);
---
<Base title={app.name} description={`${app.name}: ${app.tagline} For ${app.for.replace(/^./, c => c.toLowerCase())}`} app={app.id} logo={app.logo}>
  <section class="hero">
    <div class="wrap top">
      <img class="logo" src={app.logo} width="112" height="112" alt={`${app.name} logo`} />
      <div>
        <p class="cap kicker">Datum family · Free and open source</p>
        <h1>{app.name}</h1>
        <p class="lead">{app.tagline}</p>
        <p class="for"><span class="cap">For</span> {app.for}</p>
        <div class="btns">
          {app.latest
            ? <a class="btn pri" href={app.latest.download}>Download for Windows{size && <span class="sz">{size}</span>}</a>
            : <span class="btn" aria-disabled="true">Coming soon</span>}
          <a class="btn" href={gh}>GitHub</a>
        </div>
        <p class="meta"><ReleaseBadge latest={app.latest} />{app.latest && <span class="muted">Windows 10 and 11 · per-user install, no administrator rights · updates itself</span>}</p>
      </div>
    </div>
  </section>

  {app.highlights.length > 0 && (
    <section class="section" aria-labelledby="hl-h">
      <div class="wrap">
        <h2 id="hl-h" class="cap">Highlights</h2>
        <ul class="hl">{app.highlights.map(h => <li>{h}</li>)}</ul>
      </div>
    </section>
  )}

  {app.shots.length > 0 && (
    <section class="section" aria-labelledby="shots-h">
      <div class="wrap">
        <h2 id="shots-h" class="cap">Screenshots</h2>
        <div class="shots">{app.shots.map((s, i) => <Shot shot={s} eager={i === 0} />)}</div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="done-h">
    <div class="wrap">
      <h2 id="done-h" class="cap">What's done</h2>
      {done.length ? (
        <div class="log">
          {done.map((c, i) => (
            <details class="card rel" open={i < 2}>
              <summary><span class="v">{c.version}</span><time datetime={c.date}>{fmtDate(c.date)}</time></summary>
              <div class="md" set:html={c.html} />
            </details>
          ))}
        </div>
      ) : <p class="card muted">The first release notes will appear here.</p>}
      <p><a href={`${gh}/blob/HEAD/CHANGELOG.md`}>The full changelog</a> · <a href={`${gh}/releases`}>Every release</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="rm-h">
    <div class="wrap">
      <h2 id="rm-h" class="cap">Roadmap</h2>
      {app.roadmap.length ? <Roadmap stages={app.roadmap} /> : <p class="card muted">Coming soon: the roadmap appears here once {app.name} publishes <code>docs/site.json</code>. Until then, see <a href={`${gh}/blob/HEAD/docs/MEMORY.md`}>its memory and roadmap</a>.</p>}
    </div>
  </section>

  <section class="section">
    <div class="wrap btns">
      <a class="btn" href={`${gh}/issues/new`}>Suggest a feature or report an issue</a>
      <a class="btn" href={`${gh}/releases`}>Releases</a>
      <a class="btn" href={`${gh}/issues`}>Open issues</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(135deg, var(--pale), var(--bg) 70%); border-bottom: 1px solid var(--line); padding: 48px 0 40px; box-shadow: inset 0 4px 0 var(--blue); }
  .top { display: flex; gap: 32px; align-items: flex-start; }
  .logo { flex: none; }
  .kicker { margin-bottom: 6px; }
  h1 { margin-bottom: 8px; }
  .lead { font-size: 19px; color: var(--text2); max-width: 36em; }
  .for { color: var(--text2); }
  .for .cap { margin-right: 6px; }
  .sz { opacity: .8; font-weight: 500; }
  .meta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: 16px 0 0; font-size: 13.5px; }
  .hl { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .hl li { background: var(--bg2); border: 1px solid var(--line); border-radius: var(--r); padding: 14px 16px 14px 40px; position: relative; }
  .hl li::before { content: ""; position: absolute; left: 16px; top: 21px; width: 9px; height: 9px; background: var(--diamond); transform: rotate(45deg); }
  .shots { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 480px), 1fr)); }
  .log { display: grid; gap: 12px; margin-bottom: 16px; }
  .rel { padding: 0; }
  summary { display: flex; gap: 14px; align-items: baseline; padding: 14px 20px; cursor: pointer; }
  summary .v { font: 600 16px var(--mono); color: var(--ink); }
  summary time { font: 13px var(--mono); color: var(--muted); }
  .rel .md { padding: 0 20px 8px; font-size: 14.5px; border-top: 1px solid var(--line2); padding-top: 12px; }
  @media (max-width: 640px) {
    .top { flex-direction: column; gap: 16px; }
    .logo { width: 72px; height: 72px; }
    .lead { font-size: 17px; }
  }
</style>
